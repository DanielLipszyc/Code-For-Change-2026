{
  // Generated by the tools and ignored by git; nothing to edit in them
  "files.exclude": {
    "**/.next": true,
    "test-results": true,
    "playwright-report": true,
    "coverage": true,
    "*.tsbuildinfo": true,
    "next-env.d.ts": true
  },

  // Show related files folded under one entry in the Explorer:
  // each test under the file it tests, and the root config files in groups
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.test.ts",
    "*.tsx": "${capture}.test.ts, ${capture}.test.tsx",
    "package.json": "package-lock.json",
    "README.md": "LICENSE",
    ".env.example": ".env, .env.*",
    ".gitignore": ".gitattributes, .git-blame-ignore-revs",
    "eslint.config.mjs": ".prettierignore",
    "next.config.mjs": "postcss.config.mjs, tailwind.config.ts",
    "vitest.config.mts": "playwright.config.ts"
  },

  // Next.js names every page page.tsx and every API file route.ts;
  // label editor tabs by their folder instead, e.g. "[id] (api)", "map (page)"
  "workbench.editor.customLabels.patterns": {
    "**/app/**/route.ts": "${dirname} (api)",
    "**/app/**/page.tsx": "${dirname} (page)"
  },

  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true
}
