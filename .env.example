# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Clerk (https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Supabase (Project Settings -> API Keys)
SUPABASE_URL=https://<project-ref>.supabase.co
# The "Secret key": server-only, never expose it to the browser
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: only needed when PLANT_ID_ENABLED is true in src/lib/features.ts.
# The URL of the plant ID model's endpoint (services/plant-id, deployed on Modal)
MODAL_BIO_CLIP_URL=
