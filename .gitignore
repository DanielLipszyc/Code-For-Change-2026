# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea
# Share the workspace settings and recommended extensions; keep the rest personal
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# clerk configuration (can include secrets)
/.clerk/

# python (services/)
__pycache__/
*.py[cod]
.venv/

# playwright
/test-results/
/playwright-report/

# service worker, built from src/app/sw.ts
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
